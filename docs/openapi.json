  "info": {
    "description": "Region-centered access to DER adoption, demographic context, offline regression screening outputs, and precomputed evidence-grounded summaries for California ZCTAs. Every resource is keyed by a five-character region_id.",
    "title": "California DER Decision Support API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
